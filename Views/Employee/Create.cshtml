@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Create Employee";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Create Employee</h1>

    <a asp-controller="Employee"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Employees
    </a>
</div>

<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Employee Information</h4>
            </div>

            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- Name -->
                    <div class="mb-3">
                        <label asp-for="Name"
                               class="form-label">
                            Employee Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter employee name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email"
                               class="form-label">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="Enter employee email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Phone -->
                    <div class="mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Phone
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Enter 10-digit mobile number"
                               maxlength="10" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Department -->
                    <div class="mb-3">
                        <label asp-for="DepartmentId"
                               class="form-label">
                            Department
                        </label>

                        <select asp-for="DepartmentId"
                                asp-items="ViewBag.Departments"
                                class="form-select">

                            <option value="0">
                                -- Select Department --
                            </option>

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="text-danger">
                        </span>
                    </div>

                    <!-- Salary -->
                    <div class="mb-3">
                        <label asp-for="Salary"
                               class="form-label">
                            Salary
                        </label>

                        <input asp-for="Salary"
                               type="number"
                               class="form-control"
                               placeholder="Enter salary"
                               min="1"
                               step="0.01" />

                        <span asp-validation-for="Salary"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Salary must be greater than 0.
                        </small>
                    </div>

                    <!-- Joining Date -->
                    <div class="mb-3">
                        <label asp-for="JoiningDate"
                               class="form-label">
                            Joining Date
                        </label>

                        <input asp-for="JoiningDate"
                               type="date"
                               id="JoiningDate"
                               class="form-control"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="JoiningDate"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Future joining dates are not allowed.
                        </small>
                    </div>

                    <!-- Buttons -->
                    <button type="submit"
                            class="btn btn-success">
                        Save Employee
                    </button>

                    <a asp-controller="Employee"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const joiningDate =
            document.getElementById("JoiningDate");

        const today =
            new Date().toISOString().split("T")[0];

        joiningDate.max = today;

        joiningDate.addEventListener("change", function () {

            if (this.value > today) {

                alert("Joining date cannot be a future date.");

                this.value = "";
            }
        });
    </script>
}