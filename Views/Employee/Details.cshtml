@model EmployeeManagementSystem.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">

    <h1>Employee Details</h1>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to Employees
    </a>

</div>

<hr />


<div class="row">

    <!-- Profile Image -->

    <div class="col-md-4 text-center mb-4">

        @if (!string.IsNullOrEmpty(Model.ProfileImage))
        {
            <img src="@Model.ProfileImage"
                 alt="Profile Image"
                 class="img-thumbnail"
                 style="width:220px;height:220px;object-fit:cover;" />
        }
        else
        {
            <div class="border rounded d-flex align-items-center justify-content-center"
                 style="width:220px;height:220px;margin:auto;">

                <span class="text-muted">
                    No Profile Image
                </span>

            </div>
        }

    </div>


    <!-- Employee Information -->

    <div class="col-md-8">

        <div class="card">

            <div class="card-header bg-dark text-white">

                <h4 class="mb-0">
                    Employee Information
                </h4>

            </div>


            <div class="card-body">

                <dl class="row">

                    <dt class="col-sm-4">
                        Employee ID
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Id
                    </dd>


                    <dt class="col-sm-4">
                        Name
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Name
                    </dd>


                    <dt class="col-sm-4">
                        Email
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Email
                    </dd>


                    <dt class="col-sm-4">
                        Phone
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Phone
                    </dd>


                    <dt class="col-sm-4">
                        Department
                    </dt>

                    <dd class="col-sm-8">
                        @(Model.Department?.Name ?? "Not Assigned")
                    </dd>


                    <dt class="col-sm-4">
                        Salary
                    </dt>

                    <dd class="col-sm-8">
                        ₹@Model.Salary.ToString("N2")
                    </dd>


                    <dt class="col-sm-4">
                        Joining Date
                    </dt>

                    <dd class="col-sm-8">
                        @Model.JoiningDate.ToString("dd-MM-yyyy")
                    </dd>

                </dl>

            </div>

        </div>


        <!-- Action Buttons -->

        <div class="mt-3">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                Edit Employee

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

</div>