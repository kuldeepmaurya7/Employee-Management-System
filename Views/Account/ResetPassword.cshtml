@model EmployeeManagementSystem.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">
                    Reset Password
                </h4>
            </div>

            <div class="card-body">

                <form asp-action="ResetPassword"
                      method="post">

                    <input type="hidden"
                           asp-for="Token" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <!-- New Password -->

                    <div class="mb-3">

                        <label asp-for="NewPassword"
                               class="form-label">
                            New Password
                        </label>

                        <input asp-for="NewPassword"
                               class="form-control"
                               placeholder="Enter new password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                        <small class="text-muted">

                            Password must contain:

                            <br />

                            • Minimum 8 characters
                            <br />

                            • Uppercase letter
                            <br />

                            • Lowercase letter
                            <br />

                            • Number
                            <br />

                            • Special character

                        </small>

                    </div>

                    <!-- Confirm Password -->

                    <div class="mb-3">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm new password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                    <button type="submit"
                            class="btn btn-success">
                        Reset Password
                    </button>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="btn btn-secondary">
                        Back to Login
                    </a>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}