@model EmployeeManagementSystem.Models.Leave

@{
    ViewData["Title"] = "Delete Leave";
}

<h1>Delete Leave</h1>

<h3>Are you sure you want to delete this leave?</h3>

<div class="card mt-3">

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Employee
            </dt>

            <dd class="col-sm-9">
                @Model.Employee?.Name
            </dd>


            <dt class="col-sm-3">
                Leave Type
            </dt>

            <dd class="col-sm-9">
                @Model.LeaveType
            </dd>


            <dt class="col-sm-3">
                Start Date
            </dt>

            <dd class="col-sm-9">
                @Model.StartDate.ToShortDateString()
            </dd>


            <dt class="col-sm-3">
                End Date
            </dt>

            <dd class="col-sm-9">
                @Model.EndDate.ToShortDateString()
            </dd>


            <dt class="col-sm-3">
                Reason
            </dt>

            <dd class="col-sm-9">
                @Model.Reason
            </dd>


            <dt class="col-sm-3">
                Status
            </dt>

            <dd class="col-sm-9">
                @Model.Status
            </dd>

        </dl>


        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>