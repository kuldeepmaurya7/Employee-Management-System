@model IEnumerable<EmployeeManagementSystem.Models.Leave>

@{
    ViewData["Title"] = "Leave Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold">
            Leave Report
        </h1>

        <p class="text-muted">
            Complete employee leave information.
        </p>

    </div>

    <div>

        <a asp-action="ExportLeavesExcel"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i>
            Excel
        </a>

        <a asp-action="ExportLeavesPdf"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>
            PDF
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead class="table-dark">

                <tr>

                    <th>ID</th>
                    <th>Employee</th>
                    <th>Leave Type</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Days</th>
                    <th>Reason</th>
                    <th>Status</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var leave in Model)
                {
                    <tr>

                        <td>
                            @leave.Id
                        </td>

                        <td>
                            @(leave.Employee?.Name ?? "N/A")
                        </td>

                        <td>
                            @leave.LeaveType
                        </td>

                        <td>
                            @leave.StartDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @leave.EndDate.ToString("dd-MM-yyyy")
                        </td>

                        <td>
                            @leave.DurationDays
                        </td>

                        <td>
                            @(leave.Reason ?? "-")
                        </td>

                        <td>

                            @if (leave.Status == "Approved")
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else if (leave.Status == "Rejected")
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>