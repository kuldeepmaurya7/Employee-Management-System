@model IEnumerable<EmployeeManagementSystem.Models.Employee>

@{
    ViewData["Title"] = "Employee Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="fw-bold">
            Employee Report
        </h1>

        <p class="text-muted">
            Complete employee information.
        </p>
    </div>

    <div>

        <a asp-action="ExportEmployeesExcel"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel me-1"></i>
            Excel
        </a>

        <a asp-action="ExportEmployeesPdf"
           class="btn btn-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i>
            PDF
        </a>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>

</div>


<div class="card shadow-sm border-0">

    <div class="table-responsive">

        <table class="table table-hover mb-0">

            <thead class="table-dark">

                <tr>

                    <th>ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Department ID</th>
                    <th>Salary</th>
                    <th>Joining Date</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var employee in Model)
                {
                    <tr>

                        <td>
                            @employee.Id
                        </td>

                        <td>
                            @employee.Name
                        </td>

                        <td>
                            @employee.Email
                        </td>

                        <td>
                            @employee.Phone
                        </td>

                        <td>
                            @employee.DepartmentId
                        </td>

                        <td>
                            ₹@employee.Salary.ToString("N2")
                        </td>

                        <td>
                            @employee.JoiningDate.ToString("dd-MM-yyyy")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>